{
  "redirects": [
    {
      "source": "/memberships",
      "destination": "/membership",
      "permanent": false
    },
    {
      "source": "/red-club/students",
      "destination": "/red-club/learners",
      "permanent": true
    },
    {
      "source": "/admin",
      "destination": "/admin/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/:a/assets/:path*",
      "destination": "/assets/:path*"
    },
    {
      "source": "/:a/:b/assets/:path*",
      "destination": "/assets/:path*"
    },
    {
      "source": "/((?!api/|admin/).*)",
      "destination": "/index.html"
    }
  ]
}

{
  "redirects": [
    {
      "source": "/memberships",
      "destination": "/corridor#memberships",
      "permanent": false
    },
    {
      "source": "/red-club/students",
      "destination": "/red-club/learners",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/:a/assets/:path*",
      "destination": "/assets/:path*"
    },
    {
      "source": "/:a/:b/assets/:path*",
      "destination": "/assets/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}

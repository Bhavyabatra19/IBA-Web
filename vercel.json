{
  "redirects": [
    {
      "source": "/memberships",
      "destination": "/membership",
      "permanent": false
    },
    {
      "source": "/red-club/students",
      "destination": "/red-club/learners",
      "permanent": true
    },
    {
      "source": "/admin",
      "destination": "/admin/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/:a/assets/:path*",
      "destination": "/assets/:path*"
    },
    {
      "source": "/:a/:b/assets/:path*",
      "destination": "/assets/:path*"
    },
    {
      "source": "/about",
      "destination": "/about/index.html"
    },
    {
      "source": "/expertise",
      "destination": "/expertise/index.html"
    },
    {
      "source": "/tokenization",
      "destination": "/tokenization/index.html"
    },
    {
      "source": "/ecosystem",
      "destination": "/ecosystem/index.html"
    },
    {
      "source": "/initiatives",
      "destination": "/initiatives/index.html"
    },
    {
      "source": "/corridor",
      "destination": "/corridor/index.html"
    },
    {
      "source": "/membership",
      "destination": "/membership/index.html"
    },
    {
      "source": "/red-club",
      "destination": "/red-club/index.html"
    },
    {
      "source": "/red-club/institutions",
      "destination": "/red-club/institutions/index.html"
    },
    {
      "source": "/red-club/learners",
      "destination": "/red-club/learners/index.html"
    },
    {
      "source": "/library",
      "destination": "/library/index.html"
    },
    {
      "source": "/connect",
      "destination": "/connect/index.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy/index.html"
    },
    {
      "source": "/brochures",
      "destination": "/brochures/index.html"
    },
    {
      "source": "/brochures/:tier",
      "destination": "/brochures/:tier/index.html"
    },
    {
      "source": "/((?!api/|admin/|brochures/).*)",
      "destination": "/index.html"
    }
  ]
}
